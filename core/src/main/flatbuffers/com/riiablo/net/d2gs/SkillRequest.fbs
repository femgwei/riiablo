namespace com.riiablo.net.packet.d2gs;

// Client input only. The server resolves the source entity from the
// authenticated connection and validates the requested skill/target.
table CastSkillRequest {
  skillId:uint16;
  targetId:int32;
  targetX:float32;
  targetY:float32;
  sequence:ulong;
  observedServerTick:ulong;
  targetTick:ulong;
}

// Authoritative result for a combat intent.  This is deliberately separate
// from EntitySync: clients must be able to retire a pending action even when
// no entity component changed during the requested tick.
table CastSkillResult {
  sequence:ulong;
  appliedTick:ulong;
  success:bool;
  reason:string;
  sourceEntityId:int32;
  targetEntityId:int32;
  skillId:uint16;
  authoritativeTick:ulong;
  finalResult:bool;
}

// Changes the authoritative left/right action. Aura activation is derived
// from the selected right action on the server, never from client state.
table SelectSkillRequest {
  requestId:uint32;
  button:uint8;
  skillId:uint16;
}

// A client may only request allocation. The server resolves the authenticated
// character and validates class, level, prerequisites, cap and available points.
table SpendSkillPointRequest {
  requestId:uint32;
  skillId:uint16;
}

table SpendSkillPointResult {
  requestId:uint32;
  success:bool;
  reason:string;
  skillId:uint16;
  skillLevel:uint8;
  skillPoints:uint16;
}
