namespace com.riiablo.net.packet.d2gs;

table WalkToLocation {
  // request
  x:int16;
  y:int16;
  // Monotonic input identity and the authoritative simulation frame on which
  // this command should become visible. Appended for wire compatibility.
  sequence:ulong;
  observedServerTick:ulong;
  targetTick:ulong;

  // response
}

table WalkToEntity {
  // request
  type:uint8;
  entityId:int32;
  sequence:ulong;
  observedServerTick:ulong;
  targetTick:ulong;

  // response
}

table RunToLocation {
  // request
  x:int16;
  y:int16;
  sequence:ulong;
  observedServerTick:ulong;
  targetTick:ulong;

  // response
}

table RunToEntity {
  // request
  type:uint8;
  entityId:int32;
  sequence:ulong;
  observedServerTick:ulong;
  targetTick:ulong;

  // response
}
