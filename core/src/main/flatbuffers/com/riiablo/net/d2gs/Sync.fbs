namespace com.riiablo.net.packet.d2gs;

union ComponentP {
  ClassP,
  CofComponentsP,
  CofTransformsP,
  CofAlphasP,
  PositionP,
  VelocityP,
  AngleP,
  PlayerP,
  DS1ObjectWrapperP,
  WarpP,
  MonsterP,
  ItemP,
  StateP,
  ObjectP,
  VitalsP,
  CofReferenceP,
  MissileP,
}

enum EntityFlags:uint8 (bit_flags) {
  deleted,
}

table EntitySync {
  entityId:int32;
  type:uint8;
  flags:EntityFlags;
  component:[ComponentP];
}

table ClassP {
  type:uint8;
}

table CofComponentsP {
  component:[uint8];
}

table CofTransformsP {
  transform:[uint8];
}

table CofAlphasP {
  alpha:[uint8];
}

table PositionP {
  x:float32;
  y:float32;
}

table VelocityP {
  x:float32;
  y:float32;
}

table AngleP {
  x:float32;
  y:float32;
}

table PlayerP {
  charClass:uint8;
  charName:string;
  // Authoritative character progression. These fields are included in every
  // player snapshot so a networked HUD cannot get stuck on the client-side
  // character file after the server awards experience or a level-up.
  experience:ulong;
  level:uint8;
  skillPoints:uint16;
  statPoints:uint16;
  // Learned/base class skills only. Equipment/default skills are derived from
  // authoritative item data and must not be persisted into the skill tree.
  skillIds:[uint16];
  skillLevels:[uint8];
}

table DS1ObjectWrapperP {
  act:uint8;
  type:uint8;
  id:uint8;
}

table WarpP {
  index:int32;
}

table MonsterP {
  monsterId:uint16;
}

table ItemP {
  data:[ubyte];
}

// Objects created by D2Game at runtime have no backing DS1 row. Carry their
// already-resolved Objects.txt class id so network clients can rebuild them.
table ObjectP {
  objectId:uint16;
}

// Authoritative server status snapshot. The three vectors share the same
// indices: stateId[i], duration[i], level[i], and velocityModifier[i] describe
// one active state. velocityModifier carries runtime stacks such as Frenzy.
table StateP {
  stateId:[uint16];
  duration:[int32];
  level:[uint8];
  velocityModifier:[int16];
}

// Compact authoritative combat state. Attribute modifiers remain server-side;
// clients only need the resolved resources used by HUD and death presentation.
table VitalsP {
  hitpoints:float32;
  maxHitpoints:float32;
  mana:float32;
  maxMana:float32;
  dead:bool;
}

// Animation identity is authoritative because attack/death transitions are
// resolved by the server combat pipeline, not predicted by network clients.
table CofReferenceP {
  mode:uint8;
  weaponClass:uint8;
}

// Authoritative projectile identity. Position, velocity and angle are sent
// as regular ECS components in the same EntitySync packet.
table MissileP {
  missileId:uint16;
  ownerId:int32;
  range:float32;
}
